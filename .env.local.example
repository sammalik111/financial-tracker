# ── Job data APIs ──────────────────────────────────────────────────────────────

# Adzuna (https://developer.adzuna.com — free tier: 250 req/day)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# Pulls from LinkedIn, Indeed, Glassdoor, ZipRecruiter, and more.
# Free tier: 200 req/month. Subscribe, copy "X-RapidAPI-Key", paste below.
RAPIDAPI_KEY=

# ── AWS ────────────────────────────────────────────────────────────────────────

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App config ─────────────────────────────────────────────────────────────────

# Optional tuning — defaults shown
HTTP_TIMEOUT_MS=8000
HTTP_RETRY_COUNT=3
